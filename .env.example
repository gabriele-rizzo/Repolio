# Repolio environment.
#
# Copy to .env.local and fill in. Every key here is declared in ENV_MANIFEST (lib/env.ts), and
# lib/env.test.ts asserts the two lists match — so this file cannot drift out of date silently.
#
# REQUIRED keys are checked at server startup (instrumentation.ts): a deployment missing one refuses to
# boot and names everything that is wrong, rather than 500-ing later on the one code path that needed it.

# ─── Database (Supabase Postgres) ────────────────────────────────────────────────
# REQUIRED. Postgres connection string used by the app (pooled).
DATABASE_URL=
# REQUIRED. Direct (unpooled) Postgres URL, used by Prisma migrations.
DIRECT_URL=

# ─── Supabase auth ───────────────────────────────────────────────────────────────
# REQUIRED. Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=
# REQUIRED. Supabase anon/publishable key, safe for the browser.
NEXT_PUBLIC_SUPABASE_KEY=
# REQUIRED. Supabase service-role key. Server-only — it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# ─── App identity ────────────────────────────────────────────────────────────────
# REQUIRED. Public origin, used to build OAuth callback and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin surface ───────────────────────────────────────────────────────────────
# REQUIRED. Shared admin password (min 16 characters). Static and long-lived — rotate it when anyone
# with access leaves.
ADMIN_PASSWORD=
# REQUIRED. HMAC key signing the admin session cookie. Anyone holding this can forge an admin session.
SESSION_SECRET=

# ─── Scheduled jobs ──────────────────────────────────────────────────────────────
# REQUIRED. Bearer token Vercel Cron presents to /api/cron/*.
CRON_SECRET=

# ─── Third parties ───────────────────────────────────────────────────────────────
# REQUIRED. Anthropic key for the report-writing Batches API.
ANTHROPIC_API_KEY=
# REQUIRED. Zernio key — the gateway holding every ad-platform token.
ZERNIO_API_KEY=
# REQUIRED. Resend key for transactional email.
RESEND_API_KEY=

# ─── Rate limiting (Upstash Redis) ───────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Without both of these, ALL rate limiting is disabled — including the
# brute-force defence on admin login. Absent in production is a hard boot failure, not a warning.
# Locally they may be left empty; rate limiting is then off and every check passes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional (built-in defaults; set only to override) ──────────────────────────
# Sender for outgoing email. Defaults to the built-in address.
RESEND_FROM=
# Zernio API base URL. Defaults to the production endpoint.
ZERNIO_API_BASE=
# Concurrent Zernio timeline fetches. Default 20.
ZERNIO_FETCH_CONCURRENCY=
# Concurrent per-day snapshot upserts. Default 10.
SNAPSHOT_UPSERT_CONCURRENCY=
# Wall clock a cron run may spend starting work. Default 54000.
CRON_BUDGET_MS=
# Wall clock the snapshot phase leaves for reports. Default 20000.
POLL_RESERVE_MS=
