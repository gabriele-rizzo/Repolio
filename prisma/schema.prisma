generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// APP SCHEMA

model Client {
    id         Int      @id @default(autoincrement())
    account_id String   @unique
    name       String
    email      String
    company    String?
    active     Boolean  @default(true)
    created_at DateTime @default(now())

    last_report DateTime?
    next_report DateTime  @default(dbgenerated("(now() + interval '30 days')"))

    snapshots  Snapshot[]
    recurrence Recurrence?
}

model Snapshot {
    id         Int       @id @default(autoincrement())
    start_date DateTime
    end_date   DateTime?
    data       Json
    created_at DateTime  @default(now())

    client_id Int
    client    Client @relation(fields: [client_id], references: [id])

    reports Report[]

    @@unique([start_date, end_date, client_id])
}

model Report {
    id         Int      @id @default(autoincrement())
    data       Json
    created_at DateTime @default(now())

    snapshot_id Int
    snapshot    Snapshot @relation(fields: [snapshot_id], references: [id])

    @@unique([snapshot_id])
}

model Recurrence {
    client_id Int    @id
    client    Client @relation(fields: [client_id], references: [id])

    ndays Float @default(30)
}
