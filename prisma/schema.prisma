generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// APP SCHEMA

model Client {
    id         Int      @id @default(autoincrement())
    account_id String   @unique
    name       String
    email      String
    company    String?
    image      String?
    active     Boolean  @default(true)
    created_at DateTime @default(now())

    // Zernio Profile that owns this client's ad connections. Lazily created on first connect.
    zernio_profile_id String? @unique

    recurrence    Recurrence?
    connections   PlatformConnection[]
    notifications Notification[]
}

model Notification {
    id Int @id @default(autoincrement())

    client_id Int
    client    Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

    type  NotificationType
    title String
    body  String?
    link  String?

    read_at    DateTime?
    created_at DateTime  @default(now())

    @@index([client_id, created_at])
}

enum NotificationType {
    REPORT_READY
    CONNECTION_EXPIRING
    CONNECTION_EXPIRED
}

model Snapshot {
    id         Int      @id @default(autoincrement())
    start_date DateTime
    platform   Platform
    data       Json
    created_at DateTime @default(now())

    ad_account_id Int
    ad_account    AdAccount @relation(fields: [ad_account_id], references: [id], onDelete: Cascade)

    report_id Int?
    report    Report? @relation(fields: [report_id], references: [id])

    @@unique([start_date, ad_account_id])
}

model Report {
    id         Int      @id @default(autoincrement())
    created_at DateTime @default(now())

    snapshots Snapshot[]

    // --- AI-GENERATED (Claude). KPIs, score and anomalies are NOT stored here —
    // they are recomputed live on the report page from snapshots over a chosen window. ---
    executive_summary String
    recommendations   Json
    trend_explanation String

    // --- F: USER INPUT (snapshotted at report time) ---
    target_cpa      Float? // #36
    target_roas     Float? // #37
    context_comment String? // #38
}

enum ScoreLabel {
    STRONG
    MODERATE
    NEEDS_IMPROVEMENT
}

model Recurrence {
    client_id Int    @id
    client    Client @relation(fields: [client_id], references: [id])

    ndays Float @default(30)
}

// OAuth credential for a platform. One per (client, platform); a single
// connection can expose many ad accounts. Zernio holds the OAuth tokens — we only
// keep references to the Zernio SocialAccount.
model PlatformConnection {
    id Int @id @default(autoincrement())

    client_id Int
    client    Client @relation(fields: [client_id], references: [id])

    platform Platform

    // Zernio references. zernio_account_id is the ads SocialAccount (e.g. metaads);
    // zernio_posting_account_id is the parent posting account (same-token platforms),
    // kept so reconnect / ad-account re-scoping can target it.
    zernio_account_id         String?
    zernio_posting_account_id String?
    status                    ConnectionStatus @default(CONNECTED)

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    ad_accounts AdAccount[]

    @@unique([client_id, platform])
}

// A single ad account managed under a connection (e.g. a Meta `act_<id>`).
model AdAccount {
    id Int @id @default(autoincrement())

    connection_id Int
    connection    PlatformConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

    external_id String
    name        String?
    currency    String?
    timezone    String?
    active      Boolean @default(true)

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    snapshots Snapshot[]

    @@unique([connection_id, external_id])
}

enum Platform {
    META
    GOOGLE
    TIKTOK
    LINKEDIN
    PINTEREST
    X
}

enum ConnectionStatus {
    CONNECTED
    DISCONNECTED
}
