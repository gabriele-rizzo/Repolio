generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// APP SCHEMA

model Client {
    id         Int      @id @default(autoincrement())
    account_id String   @unique
    name       String
    email      String
    company    String?
    image      String?
    active     Boolean  @default(true)
    // UI + report language for this client (ISO 639-1). Drives next-intl and the AI report prompt.
    //
    // Always a concrete locale, even when `locale_auto` is on: reports are generated by a cron with no
    // HTTP request to detect from, so the last detected language has to be stored for them to use.
    locale     String   @default("de")
    // True when the language follows the visitor's browser/location instead of an explicit choice.
    // Re-detected at login and whenever the locale cookie is absent, then written back to `locale`.
    // Defaults true so a new client starts in their own language; the migration set every existing
    // client to false, so nobody's language changed under them on deploy.
    locale_auto Boolean @default(true)
    created_at DateTime @default(now())

    // Zernio Profile that owns this client's ad connections. Lazily created on first connect.
    zernio_profile_id String? @unique

    recurrence      Recurrence?
    connections     PlatformConnection[]
    notifications   Notification[]
    sync_errors     SyncError[]
    report_batches  ReportBatch[]
    report_template ReportTemplate?
}

// A client-authored report layout. The body is plain text with Supabase-style `{{ .variable }}`
// placeholders and a few line prefixes (see lib/report/template/types.ts); it is the source of the
// DELIVERABLE — the PDF attachment and the standalone HTML render — not of the interactive dashboard
// view, which stays a live React surface.
//
// Exactly one owner per row: a `client_id` row is that client's default, an `ad_account_id` row
// overrides it for one account. Resolution is account override -> client default -> the built-in
// preset in lib/report/template/presets.ts, so a client who never opens the editor still gets the
// layout the report always had. Both FKs are nullable and unique — Postgres permits many NULLs in a
// unique index, which enforces "at most one template per owner" without a partial index.
model ReportTemplate {
    id         Int      @id @default(autoincrement())
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    body String

    client_id Int?    @unique
    client    Client? @relation(fields: [client_id], references: [id], onDelete: Cascade)

    ad_account_id Int?       @unique
    ad_account    AdAccount? @relation(fields: [ad_account_id], references: [id], onDelete: Cascade)
}

// One client's reports from a single generation run, held for admin review before delivery.
// Reports in a batch are invisible to the client until an admin validates the batch, at which point
// every approved report is released and the client receives ONE email covering all of them.
// `sent_at` is the state: null = pending validation, set = validated and delivered.
model ReportBatch {
    id         Int      @id @default(autoincrement())
    created_at DateTime @default(now())

    client_id Int
    client    Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

    sent_at DateTime?

    reports Report[]

    @@index([client_id, created_at])
    @@index([sent_at, created_at])
}

// Internal-only trace of pipeline failures (per account where known, else per client). Written
// best-effort by the crons via lib/sync-error.ts and pruned after 30 days; never client-facing.
// `stage` is a free string ("fetch_snapshot", "upsert_snapshots", ...) so new stages don't need
// a migration.
model SyncError {
    id         Int      @id @default(autoincrement())
    created_at DateTime @default(now())

    stage   String
    message String

    client_id Int?
    client    Client? @relation(fields: [client_id], references: [id], onDelete: Cascade)

    ad_account_id Int?
    ad_account    AdAccount? @relation(fields: [ad_account_id], references: [id], onDelete: Cascade)

    @@index([created_at])
    @@index([ad_account_id, created_at])
}

model Notification {
    id Int @id @default(autoincrement())

    client_id Int
    client    Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

    type  NotificationType
    title String
    body  String?
    link  String?

    read_at    DateTime?
    created_at DateTime  @default(now())

    @@index([client_id, created_at])
}

enum NotificationType {
    REPORT_READY
    CONNECTION_EXPIRING
    CONNECTION_EXPIRED
}

model Snapshot {
    id         Int      @id @default(autoincrement())
    start_date DateTime
    platform   Platform
    data       Json
    created_at DateTime @default(now())

    ad_account_id Int
    ad_account    AdAccount @relation(fields: [ad_account_id], references: [id], onDelete: Cascade)

    report_id Int?
    report    Report? @relation(fields: [report_id], references: [id])

    @@unique([start_date, ad_account_id])
    // Hot path: live metrics filter by ad_account_id over a date range (dashboard cards, report
    // windows). The unique index above has start_date leading, so it can't serve that predicate;
    // this one (ad_account_id leading) does. The second indexes the Report<->Snapshot join, whose
    // FK column was otherwise unindexed.
    @@index([ad_account_id, start_date])
    @@index([report_id])
}

model Report {
    id         Int      @id @default(autoincrement())
    created_at DateTime @default(now())

    snapshots Snapshot[]

    // --- AI-GENERATED (Claude). KPIs, score and anomalies are NOT stored here —
    // they are recomputed live on the report page from snapshots over a chosen window. ---
    // RETIRED: the executive summary was removed from every report surface and the model is no longer
    // asked for one. New rows are written with "" (the column is required); rows generated before the
    // change keep their text, and nothing reads it. Kept rather than dropped so no migration has to
    // run against live data to delete something harmless.
    executive_summary String
    recommendations   Json
    trend_explanation String

    // Batch generation state. The report row is created up front (KPIs render live regardless);
    // the AI section is filled asynchronously via the Anthropic Batches API (50% cheaper than live
    // calls). `ai_pending` is true from batch submission until the result is written back; `batch_id`
    // is the Anthropic message batch the request was submitted in. Both stay at their defaults for
    // reports that never need AI (e.g. zero-activity periods — created empty on purpose).
    ai_pending Boolean @default(false)
    batch_id   String?

    // --- VALIDATION / DELIVERY ---
    // Reports are generated into a per-client ReportBatch and stay invisible to the client until an
    // admin validates that batch. `approved` is the admin's per-report decision inside a pending
    // batch (defaults to true — validating sends everything that wasn't explicitly excluded).
    // `released_at` is stamped when the batch is sent and is the ONLY thing that makes a report
    // client-visible: every client-facing query filters on it. An excluded report keeps
    // released_at = null and is never shown or emailed. Reports predating this feature were
    // backfilled with released_at = created_at, so nothing already delivered disappeared.
    report_batch_id Int?
    report_batch    ReportBatch? @relation(fields: [report_batch_id], references: [id], onDelete: SetNull)
    approved        Boolean      @default(true)
    released_at     DateTime?

    // --- F: USER INPUT (snapshotted at report time) ---
    target_cpa      Float? // #36
    target_roas     Float? // #37
    context_comment String? // #38

    @@index([report_batch_id])
}

enum ScoreLabel {
    STRONG
    MODERATE
    NEEDS_IMPROVEMENT
}

// When a client's reports are generated: every `ndays`, phase-locked to `start_date`.
//
// `start_date` is the anchor — the day the FIRST report is due — and it fixes the phase of every slot
// after it (anchor + k × ndays), so a client anchored to a Saturday keeps being reported on Saturdays
// even if a cron run lands late. It is a calendar day, stored at UTC midnight like Snapshot.start_date.
// Null means no anchor was ever set, and the client's created_at stands in for it (the historical
// behaviour). The rule lives in the due_clients() SQL function, mirrored in lib/recurrence/schedule.ts.
model Recurrence {
    client_id Int    @id
    client    Client @relation(fields: [client_id], references: [id])

    // INTERVAL: every `ndays`, counted from the anchor — weekly, fortnightly, any N days.
    // MONTHLY:  calendar-aligned on `day_of_month` every `month_interval` months — "the 1st",
    //           "the 15th", "quarterly on the 1st". Interval mode cannot express these, because a
    //           month is not a whole number of days: 30-day steps from 1 January land on 31 January,
    //           then 2 March.
    mode RecurrenceMode @default(INTERVAL)

    ndays      Float     @default(30)
    start_date DateTime?

    // MONTHLY only. 31 means the last day of the month: the day is clamped to each month's length,
    // so "the 31st" is 28 February and "the 30th" never skips February.
    day_of_month   Int @default(1)
    // 1 = monthly, 3 = quarterly, 12 = yearly. Phase comes from the anchor's month.
    month_interval Int @default(1)
}

enum RecurrenceMode {
    INTERVAL
    MONTHLY
}

// OAuth credential for a platform. One per (client, platform); a single
// connection can expose many ad accounts. Zernio holds the OAuth tokens — we only
// keep references to the Zernio SocialAccount.
model PlatformConnection {
    id Int @id @default(autoincrement())

    client_id Int
    client    Client @relation(fields: [client_id], references: [id])

    platform Platform

    // Zernio references. zernio_account_id is the ads SocialAccount (e.g. metaads);
    // zernio_posting_account_id is the parent posting account (same-token platforms),
    // kept so reconnect / ad-account re-scoping can target it.
    zernio_account_id         String?
    zernio_posting_account_id String?
    status                    ConnectionStatus @default(CONNECTED)

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    ad_accounts AdAccount[]

    @@unique([client_id, platform])
}

// A single ad account managed under a connection (e.g. a Meta `act_<id>`).
model AdAccount {
    id Int @id @default(autoincrement())

    connection_id Int
    connection    PlatformConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

    external_id String
    name        String?
    currency    String?
    timezone    String?
    active      Boolean @default(true)

    // Standing context about this ad account, fed into EVERY report's AI prompt for it (business
    // model, what to judge it on, known seasonality). Distinct from Report.context_comment, which is a
    // note about one specific period and is written after that report was generated — so the model
    // never sees it. This field is read at prompt-build time, which is what makes it actually reach
    // the model. Client-supplied text: the system prompt treats it as background, never instructions.
    // Deliberately NOT exposed as a template variable — it can hold internal guidance that shouldn't
    // print in a client-facing PDF.
    context_note String?

    // Stamped after each fully-successful snapshot upsert; null or stale (>48h) on an active
    // account means its sync is silently failing — check SyncError.
    last_synced_at DateTime?

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    snapshots       Snapshot[]
    sync_errors     SyncError[]
    report_template ReportTemplate?

    @@unique([connection_id, external_id])
}

/// One row per cron invocation, written best-effort at the end of the run.
///
/// This table exists to make a TRUNCATED run visible. The daily job is deliberately best-effort
/// everywhere — a failed client never aborts the others — and Vercel kills the function outright at
/// `maxDuration` without unwinding. Both mean the interesting failure is silence: no exception, no
/// SyncError row, just fewer clients processed than exist. A run row turns that into a query:
/// `finished_at IS NULL` is a killed run, and `skipped > 0` is a run that ran out of wall clock and
/// abandoned the tail on purpose.
///
/// SyncError answers "which account failed?"; CronRun answers "did the run even get there?".
model CronRun {
    id Int @id @default(autoincrement())

    /// "daily" | "snapshots" | "poll" — which route was invoked.
    job        String
    started_at DateTime @default(now())

    /// Stamped when the run returns normally. NULL means the invocation never reached the end:
    /// killed at maxDuration, or the process died. That is the row worth alerting on.
    finished_at DateTime?

    /// Wall clock actually spent, in ms. Compare against CRON_BUDGET_MS to see how close a healthy
    /// run is running to the ceiling — the early warning before truncation starts.
    duration_ms Int?

    /// Units of work (clients) considered, completed, failed, and deferred for lack of wall clock.
    /// For the combined daily job these describe the snapshot phase — the one that scales with client
    /// count — except `skipped`, which sums the deferrals of BOTH phases so that a single
    /// `skipped > 0` is the whole run's "it started shedding work" signal. `detail` keeps the exact
    /// per-phase breakdown.
    considered Int @default(0)
    processed  Int @default(0)
    failed     Int @default(0)
    skipped    Int @default(0)

    /// Per-phase detail for the combined daily job (snapshot counts vs report counts), free-form so a
    /// new phase needs no migration.
    detail Json?

    @@index([job, started_at])
}

enum Platform {
    META
    GOOGLE
    TIKTOK
    LINKEDIN
    PINTEREST
    X
}

enum ConnectionStatus {
    CONNECTED
    DISCONNECTED
}
